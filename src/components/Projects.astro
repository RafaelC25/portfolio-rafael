---

const PROJECTS = [
    {
        title: 'Portafolio de Rafael Castillo',
        description: 'Web app to show my portfolio',
        link: '#',
        github: '#',
        image: 'https://placehold.co/300x200',
        tags: ['HTML','CSS','JavaScript']
    },
    
    
]
---

{
    PROJECTS.map(({ title, description, link, github, image, tags }) => (
    <article>
        <h3 class="text-2xl font-semibold mb-4">{title}</h3>
        <p class="text-lg mb-4 text-pretty">{description}</p>
        <ul>
            {tags.map((tag) => (
                <li>{tag}</li>
            ))}
        </ul>
        <img src={image} alt={`Captura de pantalla del proyecto ${image}`} />
    </article>
    )) 
}